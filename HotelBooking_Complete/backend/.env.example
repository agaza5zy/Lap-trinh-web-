# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:5000
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=7d

# MySQL 8 / MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=YOUR_MYSQL_PASSWORD
DB_NAME=hotel_booking
# Cloud MySQL: enable TLS if required by your provider. Keep the pool small on Vercel.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_SSL_CA=
DB_CONNECTION_LIMIT=3

# Email verification (Gmail SMTP: use an App Password, never your Gmail password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
EMAIL_VERIFICATION_REQUIRED=true

# Google Identity Services - Web OAuth Client ID
GOOGLE_CLIENT_ID=

# Sign in with Apple (Services ID + Apple Developer key)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=YOUR_APPLE_TEAM_ID
APPLE_KEY_ID=YOUR_APPLE_KEY_ID
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_APPLE_P8_KEY\n-----END PRIVATE KEY-----"
APPLE_REDIRECT_URI=https://your-domain.example.com

# VietQR bank transfer. The values below are DEMO placeholders, replace before accepting money.
BANK_BIN=970436
BANK_ACCOUNT_NO=0123456789
BANK_ACCOUNT_NAME=VNHOTEL DEMO
BANK_NAME=Vietcombank (demo)
BANK_TRANSFER_DEMO=true

# MoMo merchant credentials (sandbox or production)
MOMO_ENV=sandbox
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_PARTNER_NAME=VNHotel
MOMO_STORE_ID=VNHotel

# ZaloPay merchant credentials
ZALOPAY_ENV=sandbox
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=

# PayPal REST app credentials. PayPal checkout is USD-based; set a current VND/USD rate.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_VND_PER_USD=
PAYPAL_CURRENCY=USD

# Optional: set only when running the one-time admin seed script locally
SEED_ADMIN_EMAIL=admin@vnhotel.vn
SEED_ADMIN_PASSWORD=CHANGE_THIS_ADMIN_PASSWORD
